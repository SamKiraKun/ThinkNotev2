{
  "name": "thinknote-backend",
  "version": "1.0.0",
  "description": "Backend API for ThinkNote using TursoDB",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "postinstall": "npm run build",
    "dev": "ts-node-dev src/server.ts",
    "build": "tsc",
    "test:validation": "node scripts/validate_note_payloads.js",
    "test:routes": "node --test tests/app.test.js",
    "test": "npm run build && npm run test:validation && npm run test:routes",
    "db:push": "node scripts/push_schema.js"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.9.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.0-dev.20260416"
  }
}
