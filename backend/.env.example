PORT=3000
NODE_ENV=development

# Turso/libSQL. Leave TURSO_AUTH_TOKEN empty for local file databases if supported
# by the configured TURSO_DATABASE_URL.
TURSO_DATABASE_URL=file:thinknote-local.db
TURSO_AUTH_TOKEN=

# Browser origins allowed to call the backend in deployed environments.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_NO_ORIGIN=false

# Request hardening.
JSON_BODY_LIMIT=256kb
IP_RATE_LIMIT_MAX=300
USER_RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Firebase Admin credentials for experimental authenticated sync endpoints.
# Prefer FIREBASE_SERVICE_ACCOUNT_JSON in secret managers.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=
